# Copie este arquivo para .env e ajuste. O .env NÃO vai para o Git.

# true só em desenvolvimento (ativa o Swagger em /docs). Em produção: false.
DEBUG=true

# Desenvolvimento: SQLite local. Produção: URL do PostgreSQL do Render.
DATABASE_URL=sqlite:///./barbearia.db

# Chave para assinar os tokens. Em produção use um valor longo e aleatório, por exemplo:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Se ficar vazio com DEBUG=true, uma chave temporária é gerada a cada execução.
JWT_SECRET=

# Endereços do frontend que podem chamar a API (separados por vírgula).
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=1
LOGIN_MAX_TENTATIVAS=5
LOGIN_JANELA_MINUTOS=5
FUSO_HORARIO=America/Sao_Paulo

# Recuperação de senha por e-mail ("Esqueci minha senha").
# Endereço do site, usado para montar o link enviado no e-mail.
FRONTEND_URL=http://localhost:5173
# Sem SMTP_HOST, o link aparece no log do servidor (e na tela, só com DEBUG=true).
SMTP_HOST=
SMTP_PORTA=587
SMTP_USUARIO=
SMTP_SENHA=
SMTP_REMETENTE=

# Senhas das contas de teste criadas pelo seed.py (dados fictícios).
# Defina valores seus antes de rodar "python seed.py".
SEED_SENHA_ADMIN=
SEED_SENHA_PADRAO=
